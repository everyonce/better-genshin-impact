<ui:FluentWindow x:Class="BetterGenshinImpact.View.Windows.ChildSessionCredentialsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:i18n="clr-namespace:BetterGenshinImpact.Service.I18n"
                 Title="{i18n:T Save Windows sign-in}"
                 Width="500"
                 SizeToContent="Height"
                 ResizeMode="NoResize"
                 ExtendsContentIntoTitleBar="True"
                 FontFamily="{DynamicResource TextThemeFontFamily}"
                 WindowBackdropType="Auto"
                 WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:TitleBar Title="{i18n:T Save Windows sign-in}" ShowMaximize="False" ShowMinimize="False" />
        <StackPanel Grid.Row="1" Margin="24,12,24,24">
            <TextBlock Margin="0,0,0,16" TextWrapping="Wrap"
                       Text="{i18n:T Save your Windows account password in Windows Credential Manager for automatic Desktop Clone sign-in. Use your password instead of a Windows Hello PIN.}" />
            <Label Target="{Binding ElementName=UserNameBox}" Content="{i18n:T Windows user name}" />
            <ui:TextBox x:Name="UserNameBox" Margin="0,0,0,12" />
            <TextBlock Margin="0,0,0,12" TextWrapping="Wrap"
                       Text="{i18n:T Use the same account as the Windows sign-in prompt. Examples: DOMAIN\user or MicrosoftAccount\email.}" />
            <Label Target="{Binding ElementName=PasswordBox}" Content="{i18n:T Windows password}" />
            <PasswordBox x:Name="PasswordBox" Padding="8" MinHeight="34" />
            <TextBlock Margin="0,12,0,20" TextWrapping="Wrap"
                       Text="{i18n:T You can remove the saved sign-in from the Desktop Clone menu at any time. Saving replaces any previously saved sign-in.}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="{i18n:T Save}" Appearance="Primary" IsDefault="True" Click="OnSaveClick" MinWidth="90" />
                <ui:Button Content="{i18n:T Cancel}" IsCancel="True" MinWidth="90" Margin="12,0,0,0" />
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
